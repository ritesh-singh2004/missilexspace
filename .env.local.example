# Clerk Authentication (Clerk Dashboard -> Configure -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend (used by /api/contact, /api/research) — resend.com/api-keys
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev until a custom sending domain is verified.
RESEND_FROM=onboarding@resend.dev

# Gmail SMTP (used by /api/feedback, /api/programs-apply, /api/careers-apply)
# Use a Google Account App Password (exactly 16 characters), not your normal Gmail password:
# https://myaccount.google.com/apppasswords
ADMIN_GMAIL=
ADMIN_GMAIL_PASSWORD=
